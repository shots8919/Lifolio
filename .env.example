# ============================================================================
# Lifolio 環境変数テンプレート
# 使い方: このファイルをコピーして各環境の .env を作る（.env* は .gitignore 済み）
#   cp .env.example .env.local        # ローカル開発（supabase start の値）
#   cp .env.example .env.development  # Dev Supabaseプロジェクト
# 本番(Production)の値は .env に置かず、CI Secrets（GitHub Actions）で注入する。
# ============================================================================

# --- Local（`supabase start` が起動時に表示する値をコピー） ---
# API URL は通常 http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-local-anon-key-from-`supabase status`

# --- Development / Production ---
# それぞれの Supabase プロジェクトの URL / anon key を使う。
# 本番は GitHub Actions の Secrets（VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY）で管理し、
# ローカルの .env には書かない。

# --- （将来 S3）Agent Server 用。クライアントには絶対に露出させない。 ---
# GROQ_API_KEY=...
# ANTHROPIC_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   # サーバ専用。フロントに渡さない
